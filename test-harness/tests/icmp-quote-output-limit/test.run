# A fragmented embedded IPv4 header grows by 28 bytes when it becomes an
# IPv6 header plus fragment header. Distinct payload markers separate the
# 65499-byte accepted quote from the 65500-byte rejected quote.

echo add nat46dev > /proc/net/nat46/control
mkdir -p /mnt/sys
mount -t sysfs none /mnt/sys
echo 65535 > /mnt/sys/class/net/tap0/mtu
echo 65535 > /mnt/sys/class/net/nat46dev/mtu
echo 65535 > /mnt/sys/module/nat46/parameters/lowest_ipv6_mtu
ifconfig nat46dev up
ip route add 0.0.0.0/0 dev nat46dev
ip -6 route add 2001:4860:4860::8888/128 dev lo
echo config nat46dev debug 255 > /proc/net/nat46/control
echo insert nat46dev local.v4 192.168.1.100/32 local.v6 2001:db8:1:1::1/128 local.style NONE remote.v4 8.8.8.8/32 remote.v6 2001:4860:4860::8888/128 remote.style NONE > /proc/net/nat46/control

echo 1048576 > /proc/sys/net/core/rmem_default
capture start nat46dev /mnt/host/test-harness/test-data/captured/icmp-quote-output-limit.jsonl
inject /mnt/host/test-harness/tests/icmp-quote-output-limit/inject-tap0.jsonl tap0 > /mnt/host/test-harness/test-data/captured/icmp-quote-output-limit-inject.log
inject /mnt/host/test-harness/tests/icmp-quote-output-limit/inject-rejected-tap0.jsonl tap0 > /mnt/host/test-harness/test-data/captured/icmp-quote-output-limit-rejected-inject.log
capture stop all

echo 1500 > /mnt/sys/class/net/tap0/mtu
echo 1280 > /mnt/sys/module/nat46/parameters/lowest_ipv6_mtu
ip -6 route del 2001:4860:4860::8888/128 dev lo
echo del nat46dev > /proc/net/nat46/control
