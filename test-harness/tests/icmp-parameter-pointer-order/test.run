# ICMPv6 Parameter Problem code 0 pointer 6 maps to the IPv4 Protocol field
# at byte 9. Code 1 pointer 6 maps to ICMPv4 Protocol Unreachable. Both emitted
# four-byte fields must have zero reserved bytes and a valid outer checksum.

echo add nat46dev > /proc/net/nat46/control
ifconfig nat46dev up
ip route add 0.0.0.0/0 dev nat46dev
ip -6 route add 2001:db8:1:1::1/128 dev nat46dev
echo config nat46dev debug 255 > /proc/net/nat46/control
echo insert nat46dev local.v4 192.168.1.100/32 local.v6 2001:db8:1:1::1/128 local.style NONE remote.v4 8.8.8.8/32 remote.v6 2001:4860:4860::8888/128 remote.style NONE > /proc/net/nat46/control

capture start nat46dev /mnt/host/test-harness/test-data/captured/icmp-parameter-pointer-order.jsonl
inject /mnt/host/test-harness/tests/icmp-parameter-pointer-order/inject-tap0.jsonl tap0 > /mnt/host/test-harness/test-data/captured/icmp-parameter-pointer-order-inject.log
capture stop all

echo del nat46dev > /proc/net/nat46/control
