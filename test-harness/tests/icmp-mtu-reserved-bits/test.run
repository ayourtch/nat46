# ICMPv4 Fragmentation Needed reserves byte 4 and uses byte 5 for the RFC 4884
# quoted-datagram length. A nonzero reserved byte must not become part of the
# translated ICMPv6 Packet Too Big MTU or its checksum.

echo add nat46dev > /proc/net/nat46/control
ifconfig nat46dev up
ip route add 0.0.0.0/0 dev nat46dev
echo config nat46dev debug 255 > /proc/net/nat46/control
echo insert nat46dev local.v4 192.168.1.100/32 local.v6 2001:db8:1:1::1/128 local.style NONE remote.v4 8.8.8.8/32 remote.v6 2001:4860:4860::8888/128 remote.style NONE > /proc/net/nat46/control

capture start nat46dev /mnt/host/test-harness/test-data/captured/icmp-mtu-reserved-bits.jsonl
inject /mnt/host/test-harness/tests/icmp-mtu-reserved-bits/inject-tap0.jsonl tap0 > /mnt/host/test-harness/test-data/captured/icmp-mtu-reserved-bits-inject.log
capture stop all

echo del nat46dev > /proc/net/nat46/control
