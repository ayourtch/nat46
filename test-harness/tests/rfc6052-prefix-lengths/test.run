# Exercise both translation directions for every RFC 6052 prefix length, then
# prove that each immediate unsupported neighbor leaves one valid /96 rule live.

echo add nat46dev > /proc/net/nat46/control
ifconfig nat46dev up
ip route add 0.0.0.0/0 dev nat46dev
ip -6 route add 2001:db8:1:1::1/128 dev nat46dev
capture start nat46dev /mnt/host/test-harness/test-data/captured/rfc6052-prefix-lengths.jsonl

echo config nat46dev local.v4 192.168.1.100/32 local.v6 2001:db8:1:1::1/128 local.style NONE local.ea-len 0 local.psid-offset 0 local.fmr-flag 0 remote.v4 0.0.0.0/0 remote.v6 2001:db8::/32 remote.style RFC6052 remote.ea-len 0 remote.psid-offset 0 remote.fmr-flag 0 debug 0 > /proc/net/nat46/control
inject /mnt/host/test-harness/tests/rfc6052-prefix-lengths/inject-valid-32.jsonl tap0 > /mnt/host/test-harness/test-data/captured/rfc6052-prefix-lengths-inject-valid-32.log

echo config nat46dev local.v4 192.168.1.100/32 local.v6 2001:db8:1:1::1/128 local.style NONE local.ea-len 0 local.psid-offset 0 local.fmr-flag 0 remote.v4 0.0.0.0/0 remote.v6 2001:db9:100::/40 remote.style RFC6052 remote.ea-len 0 remote.psid-offset 0 remote.fmr-flag 0 debug 0 > /proc/net/nat46/control
inject /mnt/host/test-harness/tests/rfc6052-prefix-lengths/inject-valid-40.jsonl tap0 > /mnt/host/test-harness/test-data/captured/rfc6052-prefix-lengths-inject-valid-40.log

