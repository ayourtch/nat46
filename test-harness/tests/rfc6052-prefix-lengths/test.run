inject /mnt/host/test-harness/tests/rfc6052-prefix-lengths/inject-valid-64.jsonl tap0 > /mnt/host/test-harness/test-data/captured/rfc6052-prefix-lengths-inject-valid-64.log

echo config nat46dev local.v4 192.168.1.100/32 local.v6 2001:db8:1:1::1/128 local.style NONE local.ea-len 0 local.psid-offset 0 local.fmr-flag 0 remote.v4 0.0.0.0/0 remote.v6 2001:dbd:5:6::/96 remote.style RFC6052 remote.ea-len 0 remote.psid-offset 0 remote.fmr-flag 0 debug 0 > /proc/net/nat46/control
