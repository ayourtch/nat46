# Every rejected update starts from the same exact NONE rule.  Preserve both
# sides of each update for byte comparison, then send a unique control packet
# while that rule must still be active.

echo add nat46dev > /proc/net/nat46/control
ifconfig nat46dev up
ip route add 0.0.0.0/0 dev nat46dev
capture start nat46dev /mnt/host/test-harness/test-data/captured/config-ranges.jsonl

