# ICMPv6 Packet Too Big has a 32-bit MTU, while ICMPv4 Fragmentation Needed
# has a 16-bit MTU after 16 reserved bits. For source MTUs 1280, 1500, 65535,
# and 65536, require exact destination MTUs 1260, 1480, 65515, and 65516:
# subtract the 20-byte IPv6/IPv4 header delta, then clamp to 65535.

echo add nat46dev > /proc/net/nat46/control
ifconfig nat46dev up
ip route add 0.0.0.0/0 dev nat46dev
ip -6 route add 2001:db8:1:1::1/128 dev nat46dev
echo config nat46dev debug 255 > /proc/net/nat46/control
echo insert nat46dev local.v4 192.168.1.100/32 local.v6 2001:db8:1:1::1/128 local.style NONE remote.v4 8.8.8.8/32 remote.v6 2001:4860:4860::8888/128 remote.style NONE > /proc/net/nat46/control

capture start nat46dev /mnt/host/test-harness/test-data/captured/icmp-packet-too-big-mtu-width.jsonl
inject /mnt/host/test-harness/tests/icmp-packet-too-big-mtu-width/inject-tap0.jsonl tap0 > /mnt/host/test-harness/test-data/captured/icmp-packet-too-big-mtu-width-inject.log
capture stop all

echo del nat46dev > /proc/net/nat46/control
