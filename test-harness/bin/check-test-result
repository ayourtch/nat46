#!/bin/sh
set -eux
TESTNAME=$1
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

rm -f /tmp/expected.jsonl
rm -f /tmp/captured.jsonl
rm -f /tmp/packet-assertion-result.json
rm -f /tmp/expected-config.txt
rm -f /tmp/captured-config.txt

EXPECTED_CONFIG=test-data/expected/${TESTNAME}-config.txt
CAPTURED_CONFIG=test-data/captured/${TESTNAME}-config.txt
config_snapshot_matches() {
  local expected_snapshot=$1
  local captured_snapshot=$2
  local legacy_snapshot=${expected_snapshot}.legacy
  local complete_snapshot=${expected_snapshot}.complete
  local replay_snapshot=${expected_snapshot}.replay

  cmp -s "$expected_snapshot" "$captured_snapshot" ||
    { [ -s "$legacy_snapshot" ] &&
      cmp -s "$legacy_snapshot" "$captured_snapshot"; } ||
    { [ -s "$complete_snapshot" ] &&
      cmp -s "$complete_snapshot" "$captured_snapshot"; } ||
    { [ -s "$replay_snapshot" ] &&
      cmp -s "$replay_snapshot" "$captured_snapshot"; }
}

check_config_snapshot() {
  local expected_snapshot captured_snapshot first_before before after
  local expected_pairs=0
  local actual_pairs=0

  if [ "$TESTNAME" = "proc-replay" ]; then
    expected_snapshot=test-data/captured/proc-replay-roundtrip-before.txt
    captured_snapshot=test-data/captured/proc-replay-roundtrip-after.txt
    if [ ! -s "$expected_snapshot" ] || [ ! -s "$captured_snapshot" ] ||
       ! cmp -s "$expected_snapshot" "$captured_snapshot"; then
      echo "FAIL: replay changed proc configuration bytes for ${TESTNAME}" >&2
      exit 1
    fi
    replay_input=/tmp/proc-replay-input.txt
    replay_count=0
    : > "$replay_input"
    while IFS= read -r replay_command; do
      case "$replay_command" in
        "echo > /proc/net/nat46/control")
          replay_payload=""
          ;;
        "echo "*" > /proc/net/nat46/control")
          replay_payload=${replay_command#echo }
          replay_payload=${replay_payload% > /proc/net/nat46/control}
          ;;
        *)
          echo "FAIL: malformed replay command for ${TESTNAME}" >&2
          exit 1
          ;;
      esac
      printf '%s\n' "$replay_payload" >> "$replay_input"
      replay_count=$((replay_count + 1))
    done < tests/proc-replay/replay.run
    if [ "$replay_count" -ne 5 ] ||
       ! cmp -s "$EXPECTED_CONFIG" "$replay_input"; then
      echo "FAIL: replay command payloads differ for ${TESTNAME}" >&2
      exit 1
    fi
    if ! grep -Fqx "Replay complete: 5 line writes" \
       test-data/captured/proc-replay-runtime.txt; then
      echo "FAIL: replay line-write completion is missing for ${TESTNAME}" >&2
      exit 1
    fi
  fi

  if [ -f "$EXPECTED_CONFIG" ]; then
    if [ ! -s "$CAPTURED_CONFIG" ]; then
      echo "FAIL: configuration snapshot is missing or empty for ${TESTNAME}" >&2
      exit 1
    fi
    if [ "$TESTNAME" = "proc-config-long" ]; then
      if ! cmp -s "$EXPECTED_CONFIG" "$CAPTURED_CONFIG"; then
        echo "FAIL: complete configuration snapshot differs for ${TESTNAME}" >&2
        diff -u "$EXPECTED_CONFIG" "$CAPTURED_CONFIG"
        exit 1
      fi
    else
      if ! config_snapshot_matches "$EXPECTED_CONFIG" "$CAPTURED_CONFIG"; then
        echo "FAIL: configuration snapshot differs for ${TESTNAME}" >&2
        exit 1
      fi
    fi
  fi

  first_before=""
  for before in test-data/captured/${TESTNAME}-preserve-*-before.txt; do
    [ -e "$before" ] || continue
    after=${before%-before.txt}-after.txt
    if [ ! -s "$before" ] || [ ! -s "$after" ]; then
      echo "FAIL: preservation snapshot pair is missing or empty for ${TESTNAME}" >&2
      exit 1
    fi
    if ! cmp -s "$before" "$after"; then
      echo "FAIL: rejected update changed configuration in ${before}" >&2
      exit 1
    fi
    if [ -z "$first_before" ]; then
      first_before=$before
    elif ! cmp -s "$first_before" "$before"; then
      echo "FAIL: preservation cases did not start from one baseline for ${TESTNAME}" >&2
      exit 1
    fi
    actual_pairs=$((actual_pairs + 1))
  done
  for expected_snapshot in tests/${TESTNAME}/inject-case-*.jsonl; do
    [ -e "$expected_snapshot" ] || continue
    expected_pairs=$((expected_pairs + 1))
  done
  if [ "$actual_pairs" -ne "$expected_pairs" ]; then
    echo "FAIL: expected ${expected_pairs} preservation pairs, found ${actual_pairs} for ${TESTNAME}" >&2
    exit 1
  fi

  for expected_snapshot in test-data/expected/${TESTNAME}-accepted-*.txt; do
    [ -e "$expected_snapshot" ] || continue
    captured_snapshot=test-data/captured/$(basename "$expected_snapshot")
    if [ ! -s "$captured_snapshot" ] ||
       ! config_snapshot_matches "$expected_snapshot" "$captured_snapshot"; then
      echo "FAIL: accepted endpoint snapshot mismatch for ${TESTNAME}: $(basename "$expected_snapshot")" >&2
      exit 1
    fi
  done
}

# Predicate-based checks let security regressions assert only the relevant
# packet properties (for example, "no translated rx packet") without baking
# timestamps or unrelated neighbor traffic into an exact capture fixture.
ASSERTION_KIND=$(head -n 1 test-data/expected/${TESTNAME}.jsonl)
INJECTION_INPUT=tests/${TESTNAME}/inject-tap0.jsonl
if [ -f "$INJECTION_INPUT" ]; then
  INJECTION_LOG=test-data/captured/${TESTNAME}-inject.log
  # myinit ignores blank JSONL lines, so count records rather than physical
  # lines. This keeps the host's completeness check aligned with the loader.
  EXPECTED_INJECTIONS=$(awk 'NF { count++ } END { print count + 0 }' \
    "$INJECTION_INPUT")
  if [ ! -f "$INJECTION_LOG" ] ||
     ! grep -Fqx "Injection complete: ${EXPECTED_INJECTIONS} packets sent" "$INJECTION_LOG"; then
    echo "FAIL: expected ${EXPECTED_INJECTIONS} injected packet(s) for ${TESTNAME}" >&2
    cat "$INJECTION_LOG" >&2 2>/dev/null || true
    exit 1
  fi
fi
for INJECTION_INPUT in tests/${TESTNAME}/inject-case-*.jsonl \
                       tests/${TESTNAME}/inject-valid-*.jsonl; do
  [ -e "$INJECTION_INPUT" ] || continue
  INJECTION_STEM=$(basename "$INJECTION_INPUT" .jsonl)
  INJECTION_LOG=test-data/captured/${TESTNAME}-${INJECTION_STEM}.log
  EXPECTED_INJECTIONS=$(awk 'NF { count++ } END { print count + 0 }' \
    "$INJECTION_INPUT")
  if [ ! -f "$INJECTION_LOG" ] ||
     ! grep -Fqx "Injection complete: ${EXPECTED_INJECTIONS} packets sent" "$INJECTION_LOG"; then
    echo "FAIL: expected ${EXPECTED_INJECTIONS} injection(s) from ${INJECTION_STEM} for ${TESTNAME}" >&2
    cat "$INJECTION_LOG" >&2 2>/dev/null || true
    exit 1
  fi
done

if [ "$ASSERTION_KIND" = "# packet assertion" ]; then
  CAPTURED_PACKETS=test-data/captured/${TESTNAME}.jsonl
  if [ "$TESTNAME" = "proc-replay" ]; then
    CAPTURED_PACKETS=/tmp/proc-replay-captured.jsonl
    cat test-data/captured/proc-replay-source.txt \
        test-data/captured/proc-replay-replayed.txt > "$CAPTURED_PACKETS"
  fi
  tail -n +2 test-data/expected/${TESTNAME}.jsonl > /tmp/packet-assertion.json
  if ! jq -s --slurpfile spec /tmp/packet-assertion.json '
    def layer_matches($expected; $actual):
      (reduce ($expected | keys[] |
               select(. != "data_prefix" and . != "nonzero_fields")) as $key
        (true; . and ($actual[$key] == $expected[$key]))) and
      (($expected | has("data_prefix") | not) or
       ($actual.data[0:($expected.data_prefix | length)] ==
        $expected.data_prefix)) and
      (reduce ($expected.nonzero_fields[]?) as $field
        (true; . and (($actual[$field] // 0) != 0)));
    def packet_matches($expected):
      . as $actual |
      (($expected | has("direction") | not) or
       $actual.direction == $expected.direction) and
      (reduce ($expected.layers[]?) as $required
        (true; . and any($actual.layers[]?;
                         layer_matches($required; .))));
    def layer_summary:
      if .layertype == "Ip" then
        {layertype, src, dst, proto, len, id, flags}
      elif .layertype == "Ipv6" then
        {layertype, src, dst, next_header, payload_length}
      elif .layertype == "Tcp" then
        {layertype, sport, dport, flags, chksum}
      elif .layertype == "Udp" then
        {layertype, sport, dport, len, chksum}
      elif .layertype == "Icmp" then
        {layertype, typ, code, chksum}
      elif .layertype == "Icmpv6" then
        {layertype, type_, code, checksum}
      elif .layertype == "raw" then
        {layertype,
         data_length: (.data | length),
         data_prefix: .data[:16]}
      else
        {layertype}
      end;
    def packet_summary:
      {direction, layers: [.layers[]? | layer_summary]};
    . as $packets |
    ([$packets[] | select(.direction == "rx")]) as $received |
    ([$spec[0].checks[] |
      . as $check |
      {
        expected_count: $check.count,
        actual_count: ([$packets[] |
                        select(packet_matches($check.packet))] | length),
        packet: $check.packet
      }]) as $checks |
    {
      ok: (($spec[0] | has("expected_rx_count")) and
           (($received | length) == $spec[0].expected_rx_count) and
           all($checks[]; .actual_count == .expected_count)),
      expected_rx_count: $spec[0].expected_rx_count,
      actual_rx_count: ($received | length),
      checks: $checks,
      captured_directions: ($packets |
        group_by(.direction) |
        map({direction: .[0].direction, count: length})),
      captured_packets: [$packets[] | packet_summary]
    }
  ' "$CAPTURED_PACKETS" \
      > /tmp/packet-assertion-result.json; then
    echo "FAIL: could not evaluate structured packet assertion for ${TESTNAME}" >&2
    exit 1
  fi
  if ! jq -e '.ok' /tmp/packet-assertion-result.json >/dev/null; then
    echo "FAIL: structured packet assertion failed for ${TESTNAME}" >&2
    jq 'del(.ok)' /tmp/packet-assertion-result.json >&2
    exit 1
  fi
  if ! "$SCRIPT_DIR/validate-packet-checksums" \
       "$CAPTURED_PACKETS" /tmp/packet-assertion.json; then
    echo "FAIL: packet checksum assertion failed for ${TESTNAME}" >&2
    exit 1
  fi
  check_config_snapshot
  echo "PASS (packet assertion): ${TESTNAME}"
  exit 0
fi

case "$ASSERTION_KIND" in
  "# packet assertion "*)
    echo "FAIL: legacy protocol-only assertion is not supported for ${TESTNAME}" >&2
    exit 1
    ;;
esac

case "$ASSERTION_KIND" in
  "# jq assertion rx-count="*)
    EXPECTED_RX_COUNT=${ASSERTION_KIND##*=}
    case "$EXPECTED_RX_COUNT" in
      ''|*[!0-9]*)
        echo "FAIL: invalid jq rx-count for ${TESTNAME}" >&2
        exit 1
        ;;
    esac
    tail -n +2 test-data/expected/${TESTNAME}.jsonl > /tmp/assertion.jq
    ACTUAL_RX_COUNT=$(jq -s '[.[] | select(.direction == "rx")] | length' \
      test-data/captured/${TESTNAME}.jsonl)
    if [ "$ACTUAL_RX_COUNT" != "$EXPECTED_RX_COUNT" ] ||
       ! jq -s -e -f /tmp/assertion.jq test-data/captured/${TESTNAME}.jsonl; then
    echo "FAIL: packet assertion failed for ${TESTNAME}" >&2
    jq -s '
      {
        packets: length,
        directions: (group_by(.direction) |
          map({direction: .[0].direction, count: length})),
        packet_summaries: map({
          direction,
          layers: [.layers[]? |
            if .layertype == "Ip" then
              {layertype, src, dst, proto}
            elif .layertype == "Ipv6" then
              {layertype, src, dst, next_header, payload_length}
            else
              {layertype}
            end]
        })
      }' test-data/captured/${TESTNAME}.jsonl >&2 || true
    exit 1
    fi
    check_config_snapshot
    echo "PASS (jq assertion): ${TESTNAME}"
    exit 0
    ;;
  "# jq assertion"*)
    echo "FAIL: jq assertion lacks rx-count for ${TESTNAME}" >&2
    exit 1
    ;;
esac

if [ "$(cat test-data/expected/${TESTNAME}.jsonl)" = "pass" ]; then
  echo "FAIL: survival-only expectation is not supported for ${TESTNAME}" >&2
  exit 1
fi

if jq 'del(.timestamp_us)' < test-data/expected/${TESTNAME}.jsonl > /tmp/expected.jsonl 2>/dev/null; then
  jq 'del(.timestamp_us)' < test-data/captured/${TESTNAME}.jsonl > /tmp/captured.jsonl
else
  cp test-data/expected/${TESTNAME}.jsonl /tmp/expected.jsonl
  cp test-data/captured/${TESTNAME}.jsonl /tmp/captured.jsonl
fi

diff -c /tmp/expected.jsonl /tmp/captured.jsonl
check_config_snapshot
